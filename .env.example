# Database Configuration
# For local PostgreSQL: postgresql://username:password@localhost:5432/database_name
# Replace 'yourusername' with your macOS username or postgres user
DATABASE_URL=postgresql://yourusername:password@localhost:5432/axyn_db

# Privy Configuration
# Get these from https://dashboard.privy.io → Your App → Settings
PRIVY_APP_ID=your_privy_app_id_here
PRIVY_APP_SECRET=your_privy_app_secret_here

# JWT Configuration
# Generate a secure random string (min 32 characters)
# You can use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_very_secure_jwt_secret_key_here_minimum_32_characters

# Server Configuration
PORT=3000
NODE_ENV=development

# Solana Network Configuration
# Options: 'mainnet-beta' or 'devnet'
SOLANA_NETWORK=devnet

# Solana RPC Endpoint
# For mainnet: https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# For devnet: https://api.devnet.solana.com
SOLANA_RPC_URL=https://api.devnet.solana.com

# Platform Wallet (receives payments)
# This should be your platform's Solana wallet address
PLATFORM_WALLET_ADDRESS=Apzno34N1uKnUoaiVbVVEWi4X2rsYpVx4a5HHE8FX8C4

# USDC Mint Address
# Mainnet: EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# Devnet: 4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
USDC_MINT_ADDRESS=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# HuggingFace Token (for agents using HF APIs)
HF_TOKEN=your_huggingface_token_here
