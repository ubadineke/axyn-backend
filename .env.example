# Database Configuration
# For local PostgreSQL: postgresql://username:password@localhost:5432/database_name
# Replace 'yourusername' with your macOS username or postgres user
DATABASE_URL=postgresql://yourusername:password@localhost:5432/axyn_db

# Privy Configuration
# Get these from https://dashboard.privy.io → Your App → Settings
PRIVY_APP_ID=your_privy_app_id_here
PRIVY_APP_SECRET=your_privy_app_secret_here

# JWT Configuration
# Generate a secure random string (min 32 characters)
# You can use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_very_secure_jwt_secret_key_here_minimum_32_characters

# Server Configuration
PORT=3000
NODE_ENV=development
